<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="_tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true" failOnRisky="true" failOnNotice="true" failOnDeprecation="true">
    <testsuites>
        <testsuite name="Desafios PHP">
            <directory suffix="Test.php">.</directory>
            <exclude>vendor</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include><directory suffix=".php">.</directory></include>
        <exclude>
            <directory>vendor</directory>
            <directory>_tests</directory>
            <directory>_tools</directory>
        </exclude>
    </source>
    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="display_errors" value="1"/>
        <ini name="max_execution_time" value="30"/>
    </php>
</phpunit>
